#version 450
// ===========================================================================
//  prefilter.comp — specular IBL.
//
//  GGX importance-sampled convolution of the environment, one mip per
//  roughness level. This is the first half of the split-sum approximation:
//  the second half (the BRDF LUT) is baked once by brdf_lut.comp.
//
//  Sampling uses the same Hammersley sequence and GGX importance sampling as
//  the BRDF fit, so the two halves stay consistent.
// ===========================================================================

#extension GL_GOOGLE_include_directive : require
#include "common/frame_data.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform samplerCube uEnvironment;
layout(set = 1, binding = 1, rgba16f) uniform imageCube outPrefiltered;

layout(push_constant) uniform PrefilterPC {
  vec4 params;   // x = face size, y = roughness, z = sample count, w = mip level
  vec4 extra;    // x = source size
} pc;

const float PI = 3.14159265359;

vec3 cube_direction(ivec2 px, int face, float size) {
  vec2 uv = (vec2(px) + 0.5) / size * 2.0 - 1.0;
  vec3 dir;
  switch (face) {
    case 0: dir = vec3(1.0, -uv.y, -uv.x); break;
    case 1: dir = vec3(-1.0, -uv.y, uv.x); break;
    case 2: dir = vec3(uv.x, 1.0, uv.y); break;
    case 3: dir = vec3(uv.x, -1.0, -uv.y); break;
    case 4: dir = vec3(uv.x, -uv.y, 1.0); break;
    default: dir = vec3(-uv.x, -uv.y, -1.0); break;
  }
  return normalize(dir);
}

float radical_inverse_vdc(uint bits) {
  bits = (bits << 16u) | (bits >> 16u);
  bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
  bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
  bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
  bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
  return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint n) {
  return vec2(float(i) / float(n), radical_inverse_vdc(i));
}

vec3 importance_sample_ggx(vec2 xi, vec3 N, float roughness) {
  float a = roughness * roughness;
  float phi = 2.0 * PI * xi.x;
  float cos_theta = sqrt((1.0 - xi.y) / (1.0 + (a * a - 1.0) * xi.y));
  float sin_theta = sqrt(1.0 - cos_theta * cos_theta);

  vec3 H = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);
  vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
  vec3 tangent = normalize(cross(up, N));
  vec3 bitangent = cross(N, tangent);
  return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

void main() {
  const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  const int face = int(gl_GlobalInvocationID.z);
  const int size = int(pc.params.x);
  if (px.x >= size || px.y >= size || face >= 6) return;

  const vec3 N = cube_direction(px, face, pc.params.x);
  const vec3 R = N;
  const vec3 V = R;

  const float roughness = pc.params.y;
  const uint samples = uint(pc.params.z);

  vec3 sum = vec3(0.0);
  float total_weight = 0.0;

  for (uint i = 0u; i < samples; ++i) {
    const vec2 xi = hammersley(i, samples);
    const vec3 H = importance_sample_ggx(xi, N, roughness);
    const vec3 L = normalize(2.0 * dot(V, H) * H - V);

    const float NoL = dot(N, L);
    if (NoL <= 0.0) continue;

    // Mip selection keeps the source sampling roughly constant per texel,
    // which is what removes the fireflies at low sample counts.
    float mip = roughness * float(pc.extra.x - 1.0) * 0.5;
    sum += textureLod(uEnvironment, L, mip).rgb * NoL;
    total_weight += NoL;
  }

  sum /= max(total_weight, 1e-4);
  imageStore(outPrefiltered, ivec3(px, face), vec4(sum, 1.0));
}
