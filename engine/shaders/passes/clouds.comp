#version 450
// ===========================================================================
//  clouds.comp — volumetric cloud raymarch into a half/quarter-res HDR target.
//
//  Model: two-layer noise (Perlin-Worley shape + Worley detail) inside a shell
//  between `cloudLayer.x` and `cloudLayer.y`. Lighting uses a 6-tap "beer" sun
//  march with the powder term, plus a cheap multiple-scattering octave sum.
//
//  Temporal stability comes from a per-pixel jittered ray origin (interleaved
//  gradient noise offset by the frame index) which the lighting pass resolves
//  with a temporal filter. Mobile pays ~1-3 ms at quarter res on a mid-range
//  Mali/Adreno, which is why the default preset runs at 0.35x.
// ===========================================================================

#extension GL_GOOGLE_include_directive : require
#include "common/frame_data.glsl"
#include "common/atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Cloud pass has its own descriptor set: just the output image.
layout(set = 1, binding = 0, rgba16f) uniform image2D outClouds;

layout(push_constant) uniform CloudPC {
  vec4 screen;      // xy = render size
  vec4 layer;       // x = base altitude, y = top altitude
  vec4 params;      // x = coverage, y = density, z = steps, w = frame
} pc;

// --- Hash / noise ----------------------------------------------------------
float hash12(vec2 p) {
  vec3 p3 = fract(vec3(p.xyx) * 0.1031);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}

float hash13(vec3 p) {
  p = fract(p * 0.1031);
  p += dot(p, p.zyx + 31.32);
  return fract((p.x + p.y) * p.z);
}

// Value noise with quintic interpolation — cheap and tileable enough here.
float value_noise(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);

  float n000 = hash13(i + vec3(0, 0, 0));
  float n100 = hash13(i + vec3(1, 0, 0));
  float n010 = hash13(i + vec3(0, 1, 0));
  float n110 = hash13(i + vec3(1, 1, 0));
  float n001 = hash13(i + vec3(0, 0, 1));
  float n101 = hash13(i + vec3(1, 0, 1));
  float n011 = hash13(i + vec3(0, 1, 1));
  float n111 = hash13(i + vec3(1, 1, 1));

  return mix(mix(mix(n000, n100, f.x), mix(n010, n110, f.x), f.y),
             mix(mix(n001, n101, f.x), mix(n011, n111, f.x), f.y), f.z);
}

float fbm(vec3 p, int octaves) {
  float sum = 0.0;
  float amp = 0.5;
  float norm = 0.0;
  for (int i = 0; i < octaves; ++i) {
    sum += value_noise(p) * amp;
    norm += amp;
    p *= 2.03;
    amp *= 0.5;
  }
  return sum / max(norm, 1e-4);
}

// Worley (cellular) noise for the billowy structure.
float worley(vec3 p) {
  vec3 i = floor(p);
  vec3 f = fract(p);
  float min_dist = 1.0;
  for (int z = -1; z <= 1; ++z) {
    for (int y = -1; y <= 1; ++y) {
      for (int x = -1; x <= 1; ++x) {
        vec3 g = vec3(float(x), float(y), float(z));
        vec3 o = vec3(hash13(i + g), hash13(i + g + 17.0), hash13(i + g + 41.0));
        float d = length(g + o - f);
        min_dist = min(min_dist, d);
      }
    }
  }
  return min_dist;
}

// Perlin-Worley: the classic shape function that gives cumulus its look.
float cloud_shape(vec3 p) {
  float perlin = fbm(p, 4);
  float w = worley(p * 3.0);
  float base = clamp(perlin - (1.0 - w) * 0.55, 0.0, 1.0);
  return base;
}

// --- Density field ---------------------------------------------------------
float sample_density(vec3 world, out float height_fraction) {
  const float base_alt = 1400.0;
  const float top_alt = 4200.0;

  height_fraction = (world.y - base_alt) / (top_alt - base_alt);
  if (height_fraction <= 0.0 || height_fraction >= 1.0) return 0.0;

  vec3 wind = vec3(frame.cloudWind.x, 0.0, frame.cloudWind.y) * frame.timing.x;
  vec3 p = (world + wind) * 0.00035;

  // Coverage comes straight from the scene's sky settings. A weather map is a
  // later enhancement; the shape noise already breaks up the uniformity.
  float coverage = clamp(pc.params.x * 1.35, 0.0, 1.0);
  if (coverage < 0.02) return 0.0;

  // Vertical profile: flat base, cauliflower top.
  float vertical = smoothstep(0.0, 0.12, height_fraction) *
                   smoothstep(1.0, 0.55, height_fraction);

  float shape = cloud_shape(p);
  float detail = worley(p * 6.0) * 0.5 + 0.5;
  float density = saturate1((shape - (1.0 - coverage)) * pc.params.y);
  density *= vertical;
  density *= mix(0.55, 1.0, detail);
  return density;
}

// --- Lighting --------------------------------------------------------------
// Light march towards the sun through the cloud volume (6 taps is enough at
// this density range and costs ~40% of a 12-tap march).
float sun_light_march(vec3 pos, float density) {
  const int steps = 6;
  const float step_len = 42.0;
  vec3 dir = frame.sunDirection.xyz;
  float optical = 0.0;
  float hf = 0.0;
  for (int i = 1; i <= steps; ++i) {
    float d = sample_density(pos + dir * step_len * float(i), hf);
    optical += d * step_len;
  }
  // Beer-Lambert plus the powder term (dark edges on thin cloud).
  float beer = exp(-optical * 0.12);
  float powder = 1.0 - exp(-density * 8.0);
  return beer * (0.55 + 0.45 * powder);
}

void main() {
  const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 size = ivec2(imageSize(outClouds));
  if (pixel.x >= size.x || pixel.y >= size.y) return;

  const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

  // Build a world-space ray through this pixel.
  vec4 near_clip = vec4(uv * 2.0 - 1.0, 0.0, 1.0);
  vec4 far_clip = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
  vec4 near_world = frame.invViewProj * near_clip;
  vec4 far_world = frame.invViewProj * far_clip;
  vec3 origin = frame.cameraPosition.xyz;
  vec3 dir = normalize(far_world.xyz / far_world.w - near_world.xyz / near_world.w);

  // --- Intersect the cloud shell ------------------------------------------
  const float planet_r = frame.atmosphereScale.x;
  const float base_r = planet_r + 1400.0;
  const float top_r = planet_r + 4200.0;
  vec3 cam = origin + vec3(0.0, planet_r, 0.0);

  vec2 hit_base = ray_sphere(cam, dir, base_r);
  vec2 hit_top = ray_sphere(cam, dir, top_r);

  float t_start = max(hit_base.x, 0.0);
  if (hit_base.x < 0.0) t_start = max(hit_top.x, 0.0);
  float t_end = hit_base.y > 0.0 ? hit_base.y : hit_top.y;

  if (t_end <= t_start) {
    imageStore(outClouds, pixel, vec4(0.0));
    return;
  }

  // --- Jittered march ------------------------------------------------------
  const int steps = int(clamp(pc.params.z, 16.0, 128.0));
  float jitter = ign(vec2(pixel) + vec2(pc.params.w * 5.588238));
  float dt = (t_end - t_start) / float(steps);
  float t = t_start + jitter * dt;

  vec3 scattering = vec3(0.0);
  float transmittance = 1.0;
  float total_depth = 0.0;

  for (int i = 0; i < steps && transmittance > 0.01; ++i) {
    vec3 p = origin + dir * t;
    float hf = 0.0;
    float density = sample_density(p, hf);
    t += dt;

    if (density <= 0.001) continue;

    total_depth += density * dt;

    // Sun light reaching this point, attenuated by the atmosphere below.
    float light = sun_light_march(p, density);
    float atmosphere_tau = 0.0;
    atmosphere_scattering(p, frame.sunDirection.xyz, 6, atmosphere_tau);
    light *= atmosphere_tau;

    // Multiple scattering approximation: darken the lower part, brighten tops
    // facing the sun (the "silver lining").
    float height_shade = mix(0.55, 1.0, saturate1(hf));
    float phase = phase_mie(dot(dir, frame.sunDirection.xyz), 0.6);
    vec3 sun_color = frame.sunColor.rgb * frame.sunDirection.w;

    vec3 sample_color = sun_color * light * height_shade * (0.35 + 0.65 * phase);

    // Simple ambient: sky colour at the sample height.
    vec3 ambient = vec3(0.32, 0.45, 0.68) * mix(0.4, 1.0, saturate1(hf));

    float step_trans = exp(-density * dt * 0.085);
    float contrib = (1.0 - step_trans) * transmittance;

    scattering += (sample_color + ambient) * contrib;
    transmittance *= step_trans;
  }

  // Depth for the lighting pass to composite against the scene correctly.
  float depth = t_start + total_depth / max(steps, 1) * float(steps);
  imageStore(outClouds, pixel, vec4(scattering, 1.0 - transmittance));
}
